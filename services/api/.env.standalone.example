# Standalone (non-AWS) API configuration — `node dist/server/index.mjs` or the Docker image.
# In NODE_ENV=production every mock/dev option below is refused at startup.
NODE_ENV=production
PORT=4000
WEB_BASE_URL=https://events.example.com          # used in invitation links
CORS_ORIGINS=https://events.example.com          # comma-separated exact origins

# ---- Database: postgres (production) | pglite (single-node dev) | memory (dev)
STORE=postgres
DATABASE_URL=postgres://user:password@db.example.com:5432/stagecast
DATABASE_SSL=true
DATABASE_POOL_SIZE=10
MIGRATE_ON_START=true                             # or false + run `node migrate/index.mjs` in a release step

# ---- Auth: oidc | cognito | dev
AUTH_MODE=oidc
OIDC_ISSUER=https://auth.example.com/realms/stagecast   # exact `iss`
OIDC_AUDIENCES=stagecast-web,stagecast-mobile           # accepted `aud` (client ids)
# OIDC_JWKS_URL=                                        # default: discovered from the issuer
# OIDC_EMAIL_CLAIM=email
# OIDC_EMAIL_VERIFIED_CLAIM=email_verified
# OIDC_NAME_CLAIM=name
OIDC_GROUPS_CLAIM=groups                                # dotted path ok, e.g. realm_access.roles
OIDC_ADMIN_GROUP=platform-admins
OIDC_ORGANIZER_GROUP=organizers
# Only set false if your provider never issues tokens for unverified emails:
OIDC_REQUIRE_EMAIL_VERIFIED=true

# ---- LiveKit (Cloud or self-hosted)
LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_URL=http://livekit:7880                   # only if the server reaches LiveKit at another address
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- S3-compatible object storage (Cloudflare R2, MinIO, Backblaze B2, Wasabi, AWS S3)
S3_BUCKET=stagecast-media
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=                                   # if browsers must use a different host than the server
S3_REGION=auto
S3_FORCE_PATH_STYLE=false                               # true for MinIO
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Recordings: LiveKit Egress uploads with these (prefer a key limited to writes under recordings/).
# EGRESS_S3_ACCESS_KEY_ID=
# EGRESS_S3_SECRET_ACCESS_KEY=
# EGRESS_S3_ENDPOINT=                                   # must be reachable from LiveKit's egress workers

# ---- Email: smtp | resend | ses
MAIL_PROVIDER=resend
MAIL_FROM=Stagecast <events@example.com>
RESEND_API_KEY=
# SMTP_URL=smtps://user:pass@smtp.example.com:465

# ---- Scheduler (reconcile 2 min, reminders 5 min, cleanup hourly). One replica runs each tick (Postgres lease).
SCHEDULER_ENABLED=true

# ---- Optional
# EXPO_ACCESS_TOKEN=                                    # Expo push security token
LOG_LEVEL=info
CHAT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
