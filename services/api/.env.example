# Local API server (npm run dev:api). Everything here is optional for mock mode.

PORT=4000
WEB_BASE_URL=http://localhost:3000

# Set all three to use REAL LiveKit Cloud locally (audio/video works end-to-end).
# Leave empty to use the mock LiveKit adapter (no media).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AUTH_MODE=cognito validates real Cognito ID tokens instead of dev tokens.
AUTH_MODE=dev
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_IDS=
