# Base URL of the API (API Gateway invoke URL or local dev server). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000

# "cognito" for real auth, "dev" for local-only fake sign-in (requires the local API in dev auth mode).
NEXT_PUBLIC_AUTH_MODE=dev

# Cognito (from `terraform output`)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_WEB_CLIENT_ID=

# Optional: restrict the CSP connect-src to your LiveKit project, e.g. wss://my-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_WS_ORIGIN=
