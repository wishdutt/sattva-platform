# Base URL of the API (API Gateway invoke URL or local dev server). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000

# "cognito" (AWS), "oidc" (any OpenID Connect provider), or "dev" (local-only fake sign-in).
NEXT_PUBLIC_AUTH_MODE=dev

# Cognito (from `terraform output`)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_WEB_CLIENT_ID=

# Generic OIDC (Keycloak, Auth0, Zitadel, Authentik, Okta…). Register redirect URIs
# {origin}/auth/callback and {origin}/auth/silent, and post-logout URI {origin}/login.
NEXT_PUBLIC_OIDC_AUTHORITY=
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_SCOPE=openid profile email
NEXT_PUBLIC_OIDC_PROVIDER_NAME=Company SSO

# Origin of S3-compatible storage for thumbnails/recordings (non-AWS), e.g. https://<acct>.r2.cloudflarestorage.com
NEXT_PUBLIC_MEDIA_ORIGIN=

# Optional: restrict the CSP connect-src to your LiveKit project, e.g. wss://my-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_WS_ORIGIN=
