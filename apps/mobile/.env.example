# API base URL. For a device on your LAN use your computer's IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# "cognito" (AWS), "oidc" (any OpenID Connect provider), or "dev" (local API only)
EXPO_PUBLIC_AUTH_MODE=dev
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_MOBILE_CLIENT_ID=
# OIDC: register redirect URI stagecast://auth on a public (no secret) client with PKCE.
EXPO_PUBLIC_OIDC_ISSUER=
EXPO_PUBLIC_OIDC_CLIENT_ID=
EXPO_PUBLIC_OIDC_SCOPE=openid profile email offline_access
EXPO_PUBLIC_OIDC_PROVIDER_NAME=Company SSO
# From `eas init` — required for Expo push tokens
EAS_PROJECT_ID=
APP_BUNDLE_ID=com.example.stagecast
